module yt1899 {
  namespace yt1899;
  prefix yt1899;
  yang-version 1.1;

  container top {
    grouping top-grp {
      container top-grp-cont {
        leaf top-grp-leaf {
          type string;
        }
      }
    }

    leaf other {
      type string;
    }

    choice outer {
      case first {
        leaf first-leaf {
          type string;
        }

        leaf first-other {
          type string;
        }

        choice inner {
          leaf inner-leaf {
            type string;
          }
        }
      }

      case second {
        leaf second-leaf {
          type string;
        }

        list second-list {
          key id;

          leaf id {
            type string;
          }
        }
      }
    }
  }

  grouping grp {
    container grp-cont {
      leaf grp-leaf {
        type string;
      }
    }

    choice grp-choice {
      case grp-case {
        leaf grp-case-leaf {
          type string;
        }
      }
    }
  }

  list items {
    key id;

    leaf id {
      type string;
    }

    action act {
      input {
        leaf arg {
          type string;
        }
      }
    }
  }

  notification ping {
    leaf msg {
      type string;
    }
  }

  rpc thud {
    input {
      leaf in {
        type string;
      }
    }
  }
}
