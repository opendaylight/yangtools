module yt1899 {
  namespace yt1899;
  prefix yt1899;

  container top {
    leaf other {
      type string;
    }

    choice outer {
      case first {
        leaf first-leaf {
          type string;
        }

        leaf first-other {
          type string;
        }

        choice inner {
          leaf inner-leaf {
            type string;
          }
        }
      }

      case second {
        leaf second-leaf {
          type string;
        }
      }
    }
  }
}
