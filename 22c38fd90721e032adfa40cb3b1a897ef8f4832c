      "writtenOn": "2026-11-19T12:37:31Z",
      "side": 1,
      "message": "None of the curl calls here, at 171 or in pytest-report at 216 has a timeout, and neither this job nor compose-maven-verify sets timeout-minutes, so a log server or API that accepts the connection and stalls holds the run for up to 6 hours. Could we add --connect-timeout 10 --max-time 60 (plus --retry 3 on this listing)?",
      "revId": "22c38fd90721e032adfa40cb3b1a897ef8f4832c",
      "serverId": "7fc14799-209e-464c-9743-7a06c2c21a81"
    },
